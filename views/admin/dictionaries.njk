{% extends "admin/layout.njk" %}
{% from "admin/macros.njk" import field %}
{% block title %}Категорії та словники{% endblock %}
{% block content %}
<header class="adm-head"><div><h1 class="adm-head__title">Категорії та словники фасетів</h1>
  <p class="adm-head__sub">Видалити значення, яке використовується в історіях, не можна — спершу перенесіть історії.</p></div></header>

<div class="adm-grid">
  <section class="adm-card">
    <h2 class="adm-card__title">Категорії</h2>
    <table class="tbl tbl--compact"><thead><tr><th>Назва</th><th>EN / ES</th><th class="num">Історій</th><th></th></tr></thead><tbody>
      {% for c in categories %}
      <tr><td>{{ c.name }}</td><td class="muted">{{ c.name_en }} / {{ c.name_es }}</td><td class="num">{{ catUse[c.id] or 0 }}</td>
        <td class="nowrap"><button class="icon-btn" type="button" data-fill-form="category" data-values='{{ {id: c.id, name: c.name, name_en: c.name_en, name_es: c.name_es, sort: c.sort} | dump | safe }}' aria-label="Редагувати"><svg width="18" height="18"><use href="/sprite.svg#icon-edit"></use></svg></button>
        <button class="icon-btn icon-btn--danger" type="button" data-delete="/admin/categories/{{ c.id }}/delete" data-confirm-title="Видалити категорію «{{ c.name }}»?" data-confirm-text="Дію не можна скасувати." aria-label="Видалити"><svg width="18" height="18"><use href="/sprite.svg#icon-close"></use></svg></button></td></tr>
      {% endfor %}
    </tbody></table>
    <form class="adm-inline-form" method="post" action="/admin/categories" data-ajax-form data-form-name="category" novalidate>
      <input type="hidden" name="id" value="">
      <div class="adm-row">{{ field('name', 'Назва (uk)', '', { required: true, max: 64 }) }}{{ field('sort', 'Порядок', '0', { type: 'number', min: 0 }) }}</div>
      <div class="adm-row">{{ field('name_en', 'EN', '', { max: 64 }) }}{{ field('name_es', 'ES', '', { max: 64 }) }}</div>
      <button class="action action--small" type="submit">Зберегти категорію</button>
    </form>
  </section>

  <section class="adm-card">
    <h2 class="adm-card__title">Теги</h2>
    <div class="chips-admin">
      {% for v in facets.tags %}
      <span class="chip-admin">{{ v.label_uk }} <span class="muted">{{ v.slug }} · {{ tagUse[v.slug] or 0 }}</span>
        <button type="button" class="icon-btn" data-fill-form="facet" data-values='{{ {facet: "tags", slug: v.slug, label_uk: v.label_uk, label_en: v.label_en, label_es: v.label_es, sort: v.sort} | dump | safe }}' aria-label="Редагувати"><svg width="14" height="14"><use href="/sprite.svg#icon-edit"></use></svg></button>
        <button type="button" class="icon-btn icon-btn--danger" data-delete="/admin/facets/{{ v.id }}/delete" data-confirm-title="Видалити тег «{{ v.label_uk }}»?" data-confirm-text="Дію не можна скасувати." aria-label="Видалити"><svg width="14" height="14"><use href="/sprite.svg#icon-close"></use></svg></button></span>
      {% endfor %}
    </div>
    <h3 class="adm-card__sub">Системні значення (лише перейменування)</h3>
    {% for fk, title in {season: 'Сезон', budget: 'Бюджет', trip: 'Тип поїздки', days: 'Тривалість'} %}
    <p class="muted">{{ title }}:
      {% for v in facets[fk] %}<button type="button" class="pill" data-fill-form="facet" data-values='{{ {facet: fk, slug: v.slug, label_uk: v.label_uk, label_en: v.label_en, label_es: v.label_es, sort: v.sort} | dump | safe }}'>{{ v.label_uk }}</button>{% endfor %}</p>
    {% endfor %}
    <form class="adm-inline-form" method="post" action="/admin/facets" data-ajax-form data-form-name="facet" novalidate>
      <div class="adm-row">
        <div class="field"><label class="field__label" for="facet">Фасет</label><select class="field__select" id="facet" name="facet"><option value="tags">Теги</option><option value="season">Сезон</option><option value="budget">Бюджет</option><option value="trip">Тип поїздки</option><option value="days">Тривалість</option></select><span class="field__error"></span></div>
        {{ field('slug', 'Slug (латиниця)', '', { required: true, max: 40 }) }}
      </div>
      <div class="adm-row">{{ field('label_uk', 'Назва uk', '', { required: true }) }}{{ field('label_en', 'Назва en', '', { required: true }) }}</div>
      <div class="adm-row">{{ field('label_es', 'Назва es', '', { required: true }) }}{{ field('sort', 'Порядок', '0', { type: 'number', min: 0 }) }}</div>
      <button class="action action--small" type="submit">Зберегти значення</button>
    </form>
  </section>
</div>

<section class="adm-card">
  <h2 class="adm-card__title">Країни ({{ countries.length }})</h2>
  <div class="tbl-wrap"><table class="tbl tbl--compact"><thead><tr><th>Код</th><th>Українською</th><th>English</th><th>Español</th><th class="num">Історій</th><th></th></tr></thead><tbody>
    {% for c in countries %}
    <tr><td>{{ c.code }}</td><td>{{ c.name_uk }}</td><td>{{ c.name_en }}</td><td>{{ c.name_es }}</td><td class="num">{{ countryUse[c.code] or 0 }}</td>
      <td class="nowrap"><button class="icon-btn" type="button" data-fill-form="country" data-values='{{ c | dump | safe }}' aria-label="Редагувати"><svg width="18" height="18"><use href="/sprite.svg#icon-edit"></use></svg></button>
      <button class="icon-btn icon-btn--danger" type="button" data-delete="/admin/countries/{{ c.code }}/delete" data-confirm-title="Видалити країну {{ c.name_uk }}?" data-confirm-text="Дію не можна скасувати." aria-label="Видалити"><svg width="18" height="18"><use href="/sprite.svg#icon-close"></use></svg></button></td></tr>
    {% endfor %}
  </tbody></table></div>
  <form class="adm-inline-form adm-inline-form--row" method="post" action="/admin/countries" data-ajax-form data-form-name="country" novalidate>
    {{ field('code', 'Код ISO', '', { required: true, max: 2 }) }}{{ field('name_uk', 'Назва uk', '', { required: true }) }}{{ field('name_en', 'Назва en', '', { required: true }) }}{{ field('name_es', 'Назва es', '', { required: true }) }}
    <button class="action action--small" type="submit">Зберегти країну</button>
  </form>
</section>
{% endblock %}
