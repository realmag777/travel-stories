<!DOCTYPE html>
<html lang="{{ htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seo.title }}</title>
  <meta name="description" content="{{ seo.description }}">
  <link rel="canonical" href="{{ seo.canonical }}">
  {% for alt in seo.alternates %}<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}">
  {% endfor %}
  {% if seo.noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <meta property="og:site_name" content="{{ t('site.name') }}">
  <meta property="og:type" content="{{ seo.ogType or 'website' }}">
  <meta property="og:title" content="{{ seo.ogTitle or seo.title }}">
  <meta property="og:description" content="{{ seo.description }}">
  <meta property="og:url" content="{{ seo.canonical }}">
  <meta property="og:image" content="{{ seo.ogImage }}">
  <meta property="og:locale" content="{{ ogLocale }}">
  {% for l in ogAltLocales %}<meta property="og:locale:alternate" content="{{ l }}">
  {% endfor %}
  {% if seo.article %}<meta property="article:published_time" content="{{ seo.article.published }}">
  <meta property="article:author" content="{{ seo.article.author }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#4169e1">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="preload" href="/fonts/nunito-sans-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-cyrillic-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage.href }}"{% if preloadImage.srcset %} imagesrcset="{{ preloadImage.srcset }}" imagesizes="{{ preloadImage.sizes }}"{% endif %} fetchpriority="high">{% endif %}
  <link rel="stylesheet" href="{{ asset('app.css') }}">
  {% block head %}{% endblock %}
  {% for block in seo.jsonld %}<script type="application/ld+json">{{ block | jsonld }}</script>
  {% endfor %}
  <script>document.documentElement.classList.add('js');</script>
</head>
<body class="{{ bodyClass }}" data-locale="{{ locale }}">
  <div class="loader-bar" id="loader-bar" aria-hidden="true"></div>
  {% include "partials/header.njk" %}
  <div class="page">
    <main class="page__main{% if mainClass %} {{ mainClass }}{% endif %}" id="main">
      {% block content %}{% endblock %}
    </main>
  </div>
  {% if minimalFooter %}{% include "partials/footer-mini.njk" %}{% else %}{% include "partials/footer.njk" %}{% endif %}
  <div class="toasts" id="toasts" role="status" aria-live="polite"></div>
  <script id="i18n" type="application/json">{{ clientI18n | dump | safe }}</script>
  <script src="{{ asset('app.js') }}" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>
