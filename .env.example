# Copy to .env and fill in. `docker compose up -d` reads it.
NODE_ENV=production
APP_PORT=8350
PUBLIC_URL=http://localhost:8350
SESSION_SECRET=change-me-64-hex-chars

POSTGRES_DB=podorozhnyky
POSTGRES_USER=podorozhnyky
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5440

ADMIN_USER=admin
# bcrypt hash of the admin password, single-quoted (contains $):
#   docker compose run --rm app node tools/hash-password.js 'your-password'
ADMIN_PASS_HASH='$2a$12$replace.with.a.real.bcrypt.hash........................'

MCP_TOKEN=change-me-random-token

# LLM: anthropic | openai-compatible (empty = built-in rule parser)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Only for openai-compatible, e.g. https://api.openai.com/v1 or http://ollama:11434/v1
LLM_BASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Подорожники+ <no-reply@example.com>
BOOKING_NOTIFY_EMAIL=

# 1 = import categories/stories/users from the original API on first start
IMPORT_ORIGINAL=1
