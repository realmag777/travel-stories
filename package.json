{
  "name": "podorozhnyky-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Podorozhnyky+ — Node.js remake of the Travel Stories diploma project with facets, NL search, map, booking, i18n, MCP and admin",
  "type": "commonjs",
  "main": "start.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node start.js",
    "build": "node tools/build-assets.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "seed": "node tools/bootstrap.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "crawl": "node tools/crawl-original.js",
    "visual": "node tools/visual-diff.js",
    "demo": "node scripts/demo.js",
    "demo:reset": "node scripts/demo.js --reset",
    "demo:snapshot": "node tools/demo-snapshot.js"
  },
  "author": "Rostislav Sofronov (realmag777)",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "knex": "^3.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "modern-normalize": "^3.0.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
