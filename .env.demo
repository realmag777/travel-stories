# ТОЛЬКО ДЛЯ ЛОКАЛЬНОГО ДЕМО. Не используйте эти пароли и токены на сервере.
# scripts/demo.sh / demo.ps1 копируют этот файл в .env, если .env ещё нет.

NODE_ENV=production
# Порт сайта на localhost. Занят? Поменяйте здесь (и в .env, если он уже создан).
APP_PORT=8080
APP_BIND=127.0.0.1

SESSION_SECRET=demo-only-session-secret-change-me-for-production-0001

POSTGRES_DB=podorozhnyky
POSTGRES_USER=podorozhnyky
POSTGRES_PASSWORD=demo-db-password

# Вход в админку демо
ADMIN_USER=admin
DEMO_ADMIN_PASS=demo-admin-2026
ADMIN_PASS_HASH='$2b$10$D0Tlp8DIQ4kh129GgFGLc.E/EYHEHRMBhTSzMeR2ZGC1CqdLMHnxm'

MCP_TOKEN=demo-mcp-token-0001

# Демо работает только на данных из demo/db/demo.dump: никаких импортов и генерации
DEMO_MODE=1
IMPORT_ORIGINAL=0

# LLM выключен: поиск обычным языком работает на встроенном разборщике правил
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# SMTP выключен: письма о бронированиях пишутся в лог контейнера
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Подорожники+ <no-reply@localhost>
BOOKING_NOTIFY_EMAIL=
