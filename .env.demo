# LOCAL DEMO ONLY. Never use these passwords and tokens on a server.
# scripts/demo.sh / demo.ps1 copy this file to .env if there is no .env yet.

NODE_ENV=production
# Site port on localhost. Taken? Change it here (and in .env if it already exists).
APP_PORT=8080
APP_BIND=127.0.0.1

SESSION_SECRET=demo-only-session-secret-change-me-for-production-0001

POSTGRES_DB=podorozhnyky
POSTGRES_USER=podorozhnyky
POSTGRES_PASSWORD=demo-db-password

# Demo admin login
ADMIN_USER=admin
DEMO_ADMIN_PASS=demo-admin-2026
ADMIN_PASS_HASH='$2b$10$D0Tlp8DIQ4kh129GgFGLc.E/EYHEHRMBhTSzMeR2ZGC1CqdLMHnxm'

MCP_TOKEN=demo-mcp-token-0001

# The demo uses only the data from demo/db/demo.dump: no imports, no generation
DEMO_MODE=1
IMPORT_ORIGINAL=0

# LLM off: plain-language search runs on the built-in rule parser
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# SMTP off: booking e-mails are written to the container log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Подорожники+ <no-reply@localhost>
BOOKING_NOTIFY_EMAIL=
